{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hodge.computer exact instance",
  "type": "object",
  "required": ["id", "title", "q", "F", "A", "formalStatus", "evidenceKind", "certificateAvailable", "render"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "title": {"type": "string"},
    "q": {"enum": [1, 2]},
    "F": {"$ref": "#/$defs/polynomial"},
    "A": {"$ref": "#/$defs/polynomial"},
    "D": {"$ref": "#/$defs/polynomial"},
    "formalStatus": {"enum": ["unproved", "proved"]},
    "evidenceKind": {"enum": ["none", "explicit-certificate", "existence-proof"]},
    "certificateAvailable": {"type": "boolean"},
    "witnessAvailability": {"enum": ["missing", "literal", "lean-source"]},
    "visibility": {"enum": ["navigation", "hidden"]},
    "render": {"type": "object", "required": ["seed", "phaseSigns", "planeMatrix"]}
  },
  "$defs": {
    "polynomial": {
      "type": "object",
      "required": ["expression", "latex", "degree", "terms"],
      "properties": {
        "expression": {"type": "string"},
        "latex": {"type": "string"},
        "degree": {"type": "integer", "minimum": 0},
        "terms": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
            {"type": "string", "pattern": "^-?[0-9]+(/[0-9]+)?$"},
            {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "integer", "minimum": 0}}
          ]}
        }
      }
    }
  }
}
